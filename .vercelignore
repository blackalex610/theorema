# Git
.git
.gitignore

# Dependencies
node_modules
.npm
venv
__pycache__
*.pyc

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Secrets — Vercel deployments get these from the dashboard's env config, not
# from a checked-in file. Without this, backend/.env (live DB password,
# OpenAI key, SECRET_KEY) shipped inside the deployment bundle.
.env
.env.local

# Locally stored homework photos must never ship inside a deployment bundle.
backend/app/uploads

# IDE
.vscode
.idea
*.swp
*.swo

# Build outputs
dist
build

# Temporary files
*.tmp
*.temp

# Documentation
PRESENTATION.md
REMAINING_FEATURES.md

# Test files
test_*.py
*_test.py
