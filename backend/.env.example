# Application Settings
APP_NAME=Math Learning Platform
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mathlearning
# The app migrates the database to Alembic head on its first request. Set to
# false to run `alembic upgrade head` yourself as a deploy step instead.
DB_AUTO_MIGRATE=true

# CORS: a single origin or a comma-separated list (a JSON list also works)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
# 7 days. Keep it longer than the 150-minute NVO exam: there is no refresh
# endpoint, so a short expiry logs students out mid-exam.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth
GOOGLE_CLIENT_ID=845529160700-gp4b283t7n83s7kj147el2qq72quu3ie.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
# Optional: an OpenAI-compatible endpoint such as https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_VISION_MODEL=gpt-4o

# Homework photo storage. Leave the Supabase values empty in development to
# store photos on local disk (backend/app/uploads, git-ignored). On Vercel
# they are required: the function disk is read-only and not shared.
SUPABASE_URL=
# Server-side only — this key bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=homework-photos
MEDIA_RETENTION_HOURS=24

# Error monitoring (optional — leave empty to disable Sentry entirely)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
