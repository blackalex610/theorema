# Application Settings
APP_NAME=Math Learning Platform
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mathlearning

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=845529160700-gp4b283t7n83s7kj147el2qq72quu3ie.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OpenAI Configuration (for future implementation)
OPENAI_API_KEY=your-openai-api-key-here

# Error monitoring (optional — leave empty to disable Sentry entirely)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
